# WhatsVault configuration — copy to `.env` and edit. NEVER commit `.env`.
#
# WhatsVault deliberately reads NO secrets from the environment. Every key and
# token lives in the macOS Keychain (see INV-ATREST in the design spec) and is
# fetched at runtime. This file therefore contains only non-secret paths and
# tuning values. If you ever find yourself adding a token here, that is a bug.

# Root of the local data directory (databases, blobs, logs, runtime sockets).
# Default: ~/.whatsvault
WHATSVAULT_HOME=

# Loopback bind for the read-only MCP server. This must never be a public
# address: the surface returns private message content and is protected by a
# bearer token, not by network position.
# Defaults: 127.0.0.1 / 8765
WHATSVAULT_MCP_HOST=127.0.0.1
WHATSVAULT_MCP_PORT=8765
